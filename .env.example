APP_ENV=local
DATABASE_URL=postgresql://local_runtime:local_runtime_only_change_me@127.0.0.1:54329/medical_device
DATABASE_ADMIN_URL=postgresql://local_app:local_only_change_me@127.0.0.1:54329/medical_device
AZURITE_BLOB_ENDPOINT=http://127.0.0.1:10000/devstoreaccount1
AZURITE_QUEUE_ENDPOINT=http://127.0.0.1:10001/devstoreaccount1
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1
STORAGE_ACCOUNT_URL=
STORAGE_CONTAINER_NAME=source-assets
STORAGE_MAX_READ_BYTES=134217728
UPLOAD_SESSION_TTL_SECONDS=900

# Azure worker handoff (required by the deployed worker; not needed by pnpm demo).
# OpenMontage defaults to the deterministic fixture for local/demo workers. Production
# workers should use the configured provider endpoint and retain the returned metadata.
OPENMONTAGE_PROVIDER_MODE=deterministic
OPENMONTAGE_PROVIDER_URL=
OPENMONTAGE_PROVIDER_API_KEY=
OPENMONTAGE_FIXTURE_VIDEO=fixtures/nxstage-system-one/nxstage-office-background-photo-openmontage.mp4
# Narration defaults to a deterministic silent WAV locally. Set HTTP plus the
# Azure Speech endpoint/key in the deployment secret store for real voiceover.
AZURE_SPEECH_MODE=deterministic
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_API_KEY=
AZURE_SPEECH_VOICE=en-US-JennyNeural
AZURE_SPEECH_LOCALE=en-US
# The worker uses the runtime login for tenant-scoped work and a separate
# outbox publisher login for queue publication. Keep passwords/secrets in the
# deployment secret store, never in this file.
POSTGRES_HOST=
POSTGRES_DATABASE=medical_device
POSTGRES_RUNTIME_LOGIN=medical_device_runtime
POSTGRES_RUNTIME_PASSWORD=
POSTGRES_ADMIN_LOGIN=mdtadmin
POSTGRES_ADMIN_PASSWORD=
POSTGRES_OUTBOX_LOGIN=medical_device_outbox_publisher
POSTGRES_OUTBOX_PASSWORD=
SERVICE_BUS_NAMESPACE=
SERVICE_BUS_QUEUE_NAME=asset-processing
SERVICE_BUS_SIGNING_SECRET=
ASSET_PROCESSOR_MODULE=./pilot-asset-processor.js
WORKER_ID=
WORKER_MAX_CONCURRENT_CALLS=1
RUN_DATABASE_MIGRATIONS=false
BLENDER_EXECUTABLE=blender
BLENDER_SCRIPT=./tools/reconstruction/blender_postprocess.py

AI_PROVIDER_MODE=deterministic
# Azure learning defaults to bounded planning + per-module generation. False restores one-call generation.
AI_STAGED_LEARNING=true
# Optional evaluated instructional model deployment on the existing Azure OpenAI endpoint.
# Set both names together; credentials stay in the deployment secret store.
AZURE_OPENAI_INSTRUCTIONAL_DEPLOYMENT=
AZURE_OPENAI_INSTRUCTIONAL_MODEL=
# Optional additional instructions applied to every OpenMontage image/video-generation prompt.
# Built-in defaults always require photorealistic materials, maximum realism,
# and the user's standpoint.
# Set either the inline value or a UTF-8 file path, not both. The effective prompt
# (base instructions + scene request) is persisted and hashed in the scene brief.
IMAGE_GENERATION_BASE_INSTRUCTIONS=
IMAGE_GENERATION_BASE_INSTRUCTIONS_FILE=
TENANT_CONTEXT_REQUIRED=true
AUDIT_LOGGING_ENABLED=true
LOCAL_SOURCE_DATA_ALLOWED=true
SEED_PILOT_MEMBERSHIP=false
PILOT_SUBJECT=
PILOT_ORGANIZATION_ID=org_fixture
# Optional comma-separated organization roles for explicit administrative pilot seeding.
# Omit to preserve existing roles; new memberships without assignments are learners.
PILOT_ORGANIZATION_ROLES=

# Invitation creation requires a versioned secret key map (32-byte random keys in hex).
# Supply via the deployment secret store; never commit actual values.
# Empty configuration disables creation while existing issued tokens remain acceptable.
INVITATION_TOKEN_KEYS_JSON=
INVITATION_ACTIVE_KEY_ID=
INVITATION_EXPIRY_HOURS=72
# Invitation acceptance requires signed API-token email + boolean email_verified=true.
# Email, UPN, preferred_username, or a string "true" alone do not satisfy verification.
# Validate the live Entra issuance policy before enabling invitation delivery.

# Worker invitation email transport. Disabled until sender domain/identity/delivery controls are ready.
INVITATION_EMAIL_ENABLED=false
ACS_EMAIL_ENDPOINT=
ACS_EMAIL_SENDER_ADDRESS=
APPLICATION_ORIGIN=
# ACS uses DefaultAzureCredential. API and worker must share the versioned invitation key map.
# Keep older keys until pending invitations and delivery retries using them have expired.

# Required when invitation email is enabled. Set approved limits for the ACS resource.
# Fixed one-minute reservation windows; allow headroom for other applications and boundary bursts.
INVITATION_EMAIL_GLOBAL_PER_MINUTE=
INVITATION_EMAIL_ORGANIZATION_PER_MINUTE=

# Dedicated managed-identity Event Grid -> Service Bus delivery reports. No public webhook.
EMAIL_REPORTS_ENABLED=false
EMAIL_REPORTS_SERVICE_BUS_NAMESPACE=
EMAIL_REPORTS_QUEUE=
ACS_EMAIL_RESOURCE_ID=
# The report namespace must differ from SERVICE_BUS_NAMESPACE.
# Restrict sending to the Event Grid identity; worker needs queue-scoped Data Receiver.

# Public browser registration metadata; no client secret. Disabled until configured.
# Authority: https://login.microsoftonline.com/<ENTRA_TENANT_ID> or
# https://<external-tenant-name>.ciamlogin.com/<ENTRA_TENANT_ID>.
# APPLICATION_ORIGIN above is shared; use HTTPS except local loopback development.
BROWSER_AUTH_ENABLED=false
BROWSER_AUTH_CLIENT_ID=
BROWSER_AUTH_AUTHORITY=
BROWSER_AUTH_API_SCOPE=
