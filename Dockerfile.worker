FROM node:24-trixie-slim AS openmvs
ARG OPENMVS_URL=https://github.com/cdcseacave/openMVS/releases/download/v2.4.0/OpenMVS_Ubuntu_x64.zip
ARG OPENMVS_SHA256=7104AE1DDD6CA38FBCA9E0E4A70B20AF59E21E0B497EB7181C864FBF38CA8D00
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl unzip \
 && rm -rf /var/lib/apt/lists/* \
 && curl -fsSL "$OPENMVS_URL" -o /tmp/openmvs.zip \
 && echo "$OPENMVS_SHA256  /tmp/openmvs.zip" | sha256sum -c - \
 && mkdir -p /opt/openmvs \
 && unzip -q /tmp/openmvs.zip -d /opt/openmvs \
 && chmod 0555 /opt/openmvs/* \
 && rm /tmp/openmvs.zip

FROM node:24-trixie-slim AS build
WORKDIR /workspace
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json tsconfig.json ./
COPY apps/worker/package.json apps/worker/tsconfig.json ./apps/worker/
COPY packages/simulation-schema/package.json packages/simulation-schema/tsconfig.json ./packages/simulation-schema/
COPY packages/contracts/package.json packages/contracts/tsconfig.json ./packages/contracts/
COPY packages/db/package.json packages/db/tsconfig.json ./packages/db/
COPY packages/model-runtime/package.json packages/model-runtime/tsconfig.json ./packages/model-runtime/
COPY packages/ai-gateway/package.json packages/ai-gateway/tsconfig.json ./packages/ai-gateway/
COPY packages/storage/package.json packages/storage/tsconfig.json ./packages/storage/
COPY apps/worker ./apps/worker
COPY packages/simulation-schema ./packages/simulation-schema
COPY packages/contracts ./packages/contracts
COPY packages/db ./packages/db
COPY packages/model-runtime ./packages/model-runtime
COPY packages/ai-gateway ./packages/ai-gateway
COPY packages/storage ./packages/storage
COPY tools/reconstruction ./tools/reconstruction
COPY fixtures/nxstage-system-one ./fixtures/nxstage-system-one
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @medical-device/contracts build && pnpm --filter @medical-device/simulation-schema build && pnpm --filter @medical-device/model-runtime build && pnpm --filter @medical-device/ai-gateway build && pnpm --filter @medical-device/db build && pnpm --filter @medical-device/storage build && pnpm --filter @medical-device/worker build && pnpm deploy --legacy --filter @medical-device/worker --prod /out

FROM node:24-trixie-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /workspace/tools/reconstruction/requirements.txt /tmp/reconstruction-requirements.txt
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      python3 python3-venv ffmpeg poppler-utils tesseract-ocr \
      blender \
      libgomp1 libgl1 libglib2.0-0 libsm6 libxext6 libxrender1 \
 && python3 -m venv /opt/pdf \
 && /opt/pdf/bin/pip install --no-cache-dir pypdf==6.21.4 \
 && python3 -m venv /opt/reconstruction-runtime \
 && /opt/reconstruction-runtime/bin/pip install --no-cache-dir -r /tmp/reconstruction-requirements.txt \
 && rm -rf /var/lib/apt/lists/*
ENV PDF_PYTHON=/opt/pdf/bin/python
ENV RECONSTRUCTION_PYTHON=/opt/reconstruction-runtime/bin/python
ENV PHOTOGRAMMETRY_PYTHON=/opt/reconstruction-runtime/bin/python
ENV RECONSTRUCTION_SCRIPTS_DIR=/opt/reconstruction-scripts
ENV PHOTOGRAMMETRY_OPENMVS_DIR=/opt/openmvs
ENV RECONSTRUCTION_WORK_DIR=/tmp/reconstruction
ENV BLENDER_EXECUTABLE=/usr/bin/blender
ENV BLENDER_SCRIPT=/opt/reconstruction-scripts/blender_postprocess.py
ENV BLENDER_USER_CONFIG=/tmp/blender-config
# Runtime starts Node directly; omit npm and its unnecessary dependency tree.
RUN groupadd --system app && useradd --system --gid app app \
 && rm -rf /usr/local/lib/node_modules/npm \
 && rm -f /usr/local/bin/npm /usr/local/bin/npx
COPY --from=build /out ./
COPY tools/migrate-database.mjs ./tools/migrate-database.mjs
COPY --from=build /workspace/tools/reconstruction /opt/reconstruction-scripts
COPY --from=build /workspace/fixtures/nxstage-system-one ./fixtures/nxstage-system-one
COPY --from=openmvs /opt/openmvs /opt/openmvs
RUN mkdir -p /tmp/reconstruction /tmp/blender-config && chown -R app:app /tmp/reconstruction /tmp/blender-config
USER app
CMD ["node", "dist/entrypoint.js"]

# Optional, separately isolated Python 3.11 stack. NumPy/torch requirements are
# deliberately incompatible with the photo/video PyCOLMAP environment above.
FROM python:3.11.11-slim-bookworm AS single-image-build
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 MAX_JOBS=2
RUN apt-get update && apt-get install -y --no-install-recommends git g++ libgomp1 && rm -rf /var/lib/apt/lists/* \
 && python3.11 -m venv --copies /opt/single-image/runtime
COPY tools/reconstruction/requirements-single-image.txt /tmp/single-image-requirements.txt
RUN /opt/single-image/runtime/bin/pip install --no-cache-dir torch==2.6.0 --index-url https://download.pytorch.org/whl/cpu \
 && /opt/single-image/runtime/bin/pip install --no-cache-dir -r /tmp/single-image-requirements.txt \
 && git clone https://github.com/VAST-AI-Research/TripoSR.git /opt/TripoSR \
 && git -C /opt/TripoSR checkout 107cefdc244c39106fa830359024f6a2f1c78871 \
 && test "$(git -C /opt/TripoSR rev-parse HEAD)" = 107cefdc244c39106fa830359024f6a2f1c78871 \
 && git clone https://github.com/tatsy/torchmcubes.git /opt/torchmcubes \
 && git -C /opt/torchmcubes checkout bc36b08c62c5931e1dfc666581b3a8589278647f \
 && test "$(git -C /opt/torchmcubes rev-parse HEAD)" = bc36b08c62c5931e1dfc666581b3a8589278647f \
 && /opt/single-image/runtime/bin/pip install --no-cache-dir --no-build-isolation /opt/torchmcubes \
 && /opt/single-image/runtime/bin/pip check
ENV PYTHONPATH=/opt/TripoSR HF_HUB_DISABLE_TELEMETRY=1 DO_NOT_TRACK=1
COPY tools/reconstruction/single_image_assets.py tools/reconstruction/single_image_preflight.py /opt/reconstruction-scripts/
RUN /opt/single-image/runtime/bin/python /opt/reconstruction-scripts/single_image_assets.py --assets /opt/single-image/assets \
 && HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 /opt/single-image/runtime/bin/python /opt/reconstruction-scripts/single_image_preflight.py \
      --assets /opt/single-image/assets --code /opt/TripoSR --manifest /opt/single-image/runtime-manifest.json --write-manifest \
 && rm -rf /opt/TripoSR/.git

# Select explicitly with --target worker-single-image. The final default target
# below continues to provide the original photo/video worker.
FROM runtime AS worker-single-image
USER root
COPY --from=single-image-build /usr/local/bin/python3.11 /usr/local/bin/python3.11
COPY --from=single-image-build /usr/local/lib/libpython3.11.so.1.0 /usr/local/lib/libpython3.11.so.1.0
COPY --from=single-image-build /usr/local/lib/python3.11 /usr/local/lib/python3.11
COPY --from=single-image-build /opt/single-image /opt/single-image
COPY --from=single-image-build /opt/TripoSR /opt/TripoSR
ENV RECONSTRUCTION_PYTHON=/opt/single-image/runtime/bin/python
ENV RECONSTRUCTION_SINGLE_IMAGE_ENABLED=true
ENV RECONSTRUCTION_ASSETS_DIR=/opt/single-image/assets
ENV RECONSTRUCTION_SINGLE_IMAGE_CODE_DIR=/opt/TripoSR
ENV RECONSTRUCTION_SINGLE_IMAGE_MANIFEST=/opt/single-image/runtime-manifest.json
ENV PYTHONPATH=/opt/TripoSR HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 DO_NOT_TRACK=1
RUN ldconfig \
 && /opt/single-image/runtime/bin/python /opt/reconstruction-scripts/single_image_preflight.py \
      --assets /opt/single-image/assets --code /opt/TripoSR --manifest /opt/single-image/runtime-manifest.json \
 && chmod -R a-w /opt/single-image /opt/TripoSR /usr/local/lib/python3.11
USER app

FROM runtime AS worker
